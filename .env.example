# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Supabase (cloud sync + auth)
# Get these from supabase.com → Project Settings → API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://swblfeayxoprodhwxqak.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ---------------------------------------------------------------------------
# HERE Maps (truck routing / geocoding / truck-stop POI — plan-v2.md WS-V)
# Get a key at platform.here.com → restrict it by domain + Android app id.
# Free tier: 30k requests/month — routes are cached into SavedTrip records.
# ---------------------------------------------------------------------------
VITE_HERE_API_KEY=YOUR_HERE_API_KEY

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging — web push (plan-v2.md WS-S)
# From the Firebase console (web app config + Cloud Messaging VAPID key pair).
# Native Android uses android/app/google-services.json instead (gitignored).
# The FCM service-account JSON lives ONLY in Supabase secrets, never here:
#   supabase secrets set FCM_SERVICE_ACCOUNT_JSON='{...}'
# ---------------------------------------------------------------------------
VITE_FIREBASE_CONFIG_JSON=YOUR_FIREBASE_WEB_CONFIG_JSON
VITE_FIREBASE_VAPID_KEY=YOUR_VAPID_PUBLIC_KEY
